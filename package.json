{
  "name": "orbit-support",
  "version": "0.0.0",
  "private": true,
  "description": "Orbit Support — customer-service capability for Orbit. Start at CLAUDE.md.",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check:context": "node scripts/check-context.mjs",
    "build:shared": "npm run build --workspace @orbit-support/shared",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "verify": "npm run check:context && npm run build:shared && npm run lint && npm run typecheck && npm run test && npm run test:e2e",
    "verify:full": "npm run verify && npm run build",
    "dev:web": "npm run dev --workspace web",
    "dev:api": "npm run start:dev --workspace api",
    "test:e2e": "npm run test:e2e --workspace api",
    "gate": "bash scripts/gate-commit.sh"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.3.0"
    }
  }
}
