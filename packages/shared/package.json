{
  "name": "@orbit-support/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Contracts shared by the Orbit Support API and web app: schemas, types, enums, formatting.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
