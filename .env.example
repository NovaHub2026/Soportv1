# Orbit Support — environment reference (PH-8.3, docs/runbooks/DEPLOYMENT.md). Copy to .env for docker compose.
# Never commit .env (GOVERNANCE.md §11). Values here are working defaults, not decisions.

# --- docker/compose.yml ---
POSTGRES_USER=orbit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=orbit_support
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
# Demo switch (DEC-0008). Remove or set to false once a real identity provider exists (BL-001).
SUPPORT_ALLOW_SIMULATED_IDENTITY=true

# --- API (apps/api) ---
# PORT=3001                          # listening port
# SUPPORT_BIND=127.0.0.1             # 0.0.0.0 only behind a proxy/network, with NODE_ENV=production (DEC-0031)
# SUPPORT_DATABASE_URL=              # postgres://user:pass@host:5432/db → PostgreSQL server (DEC-0032); unset → PGlite
# SUPPORT_DB_DIR=.data/pglite        # PGlite directory when no database URL is set; unset in tests → in memory
# SUPPORT_UPLOADS_DIR=.data/uploads  # attachment bytes (DEC-0009)
# WEB_ORIGIN=http://localhost:3000   # CORS origin for direct API calls
# SUPPORT_IDENTITY_PROVIDER=simulated   # the only provider today (DEC-0008)
# SUPPORT_ALLOW_SIMULATED_IDENTITY=false # required "true" to start the simulated provider with NODE_ENV=production
# SUPPORT_ORBIT_RECORDS=simulated    # the only records adapter today (DEC-0019)
# SUPPORT_SIMULATED_ORBIT=           # "unavailable" makes every simulated lookup answer unavailable (PH-4.3)
# SUPPORT_CLOSURE_JOB=off|on         # closure of resolved cases after the follow-up window (DEC-0013)
# SUPPORT_CLOSURE_INTERVAL_MS=60000
# SUPPORT_FOLLOW_UP_WINDOW_DAYS=7
# SUPPORT_NOTIFICATION_JOB=off|on    # e-mail job (DEC-0025); the notifier is simulated until a provider is chosen
# SUPPORT_NOTIFICATION_INTERVAL_MS=60000
# SUPPORT_REMINDER_JOB=off|on        # reminders for cases waiting on the customer (DEC-0026/0027)
# SUPPORT_REMINDER_INTERVAL_MS=60000
# SUPPORT_SSE_HEARTBEAT_MS=15000
# SUPPORT_SSE_MAX_PER_IDENTITY=8     # open streams per identity (DEC-0031)

# --- web (apps/web) ---
# API_ORIGIN=http://localhost:3001   # where the /api rewrite goes (inside compose: http://api:3001)
