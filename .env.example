# Orbit Support — environment reference (PH-8.3, docs/runbooks/DEPLOYMENT.md). Copy to .env for docker compose.
# Never commit .env (GOVERNANCE.md §11). Values here are working defaults, not decisions.

# --- docker/compose.yml ---
POSTGRES_USER=orbit
# Required: docker compose refuses to start while this is empty.
POSTGRES_PASSWORD=
POSTGRES_DB=orbit_support
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
# Demo switch (DEC-0008): "true" only for a demo on this machine (compose publishes the web on 127.0.0.1 only).
# With false the API refuses to start in production mode — correct until Orbit's identity exists (BL-001).
SUPPORT_ALLOW_SIMULATED_IDENTITY=false

# --- API (apps/api) ---
# PORT=3001                          # listening port
# SUPPORT_BIND=127.0.0.1             # 0.0.0.0 only behind a proxy/network, with NODE_ENV=production (DEC-0031)
# SUPPORT_DATABASE_URL=              # postgres://user:pass@host:5432/db → PostgreSQL server (DEC-0032); unset → PGlite
# SUPPORT_DB_POOL_MAX=10             # PostgreSQL pool size (at least 2)
# SUPPORT_DB_DIR=.data/pglite        # PGlite directory when no database URL is set; unset in tests → in memory
# SUPPORT_UPLOADS_DIR=.data/uploads  # attachment bytes (DEC-0009)
# WEB_ORIGIN=http://localhost:3000   # CORS origin for direct API calls
# SUPPORT_IDENTITY_PROVIDER=simulated   # simulated (DEC-0008) | optaqode — the broker's tokens verified here (PH-13, DEC-0045)
# SUPPORT_ALLOW_SIMULATED_IDENTITY=false # required "true" to start the simulated provider with NODE_ENV=production
# SUPPORT_ORBIT_RECORDS=simulated    # simulated (DEC-0019) | optaqode — the broker's customer 360 through the service credential
# SUPPORT_STAFF_DIRECTORY=           # simulated | optaqode; unset = the same as SUPPORT_ORBIT_RECORDS
# SUPPORT_SIMULATED_ORBIT=           # "unavailable" makes every simulated lookup answer unavailable (PH-4.3)

# --- Orbit (Optaqode) adapters — only read when an adapter above is "optaqode" (docs/integration/ORBIT-INTEGRATION.md) ---
# ORBIT_API_BASE_URL=https://dev-api.orbitmarket.pro/api/v1   # the broker's API with its version prefix; https except localhost
# ORBIT_SERVICE_EMAIL=               # the support service account in the broker's back-office (a read-only team member the Owner creates) …
# ORBIT_SERVICE_PASSWORD=            # … its password: the API logs in (POST /admin/auth/login) and refreshes; no 2FA on that account
# ORBIT_SERVICE_TOKEN=               # alternative to the account: a static bearer if the backend issues one
# ORBIT_JWT_SECRET=                  # optional: verify customer tokens here (HS256) instead of asking the broker — OR —
# ORBIT_JWT_JWKS_URL=                # optional: JWKS document for RS256/ES256 tokens (never both)
# ORBIT_JWT_ISSUER=                  # optional: the token's iss claim to require (local verification only)
# ORBIT_JWT_AUDIENCE=                # optional: the token's aud claim to require (local verification only)
# ORBIT_HTTP_TIMEOUT_MS=5000         # a slow broker answers "unavailable: timeout", never a hang
# ORBIT_STAFF_CACHE_MS=60000         # how long the staff listing is reused
# ORBIT_TOKEN_CACHE_MS=60000         # how long a customer token the broker accepted is trusted before it is presented again
# SUPPORT_CLOSURE_JOB=off|on         # closure of resolved cases after the follow-up window (DEC-0013)
# SUPPORT_CLOSURE_INTERVAL_MS=60000
# SUPPORT_FOLLOW_UP_WINDOW_DAYS=7
# SUPPORT_NOTIFICATION_JOB=off|on    # e-mail job (DEC-0025); the notifier is simulated until a provider is chosen
# SUPPORT_NOTIFICATION_INTERVAL_MS=60000
# SUPPORT_EMAIL_MAX_ATTEMPTS=5       # failed sends before a notification is parked as a dead letter (BL-028)
# SUPPORT_REMINDER_JOB=off|on        # reminders for cases waiting on the customer (DEC-0026/0027)
# SUPPORT_REMINDER_INTERVAL_MS=60000
# SUPPORT_SSE_HEARTBEAT_MS=15000
# SUPPORT_SSE_MAX_PER_IDENTITY=8     # open streams per identity (DEC-0031)
# SUPPORT_TRUST_PROXY=              # appending reverse proxies in front of the web (usually 1 once one exists); unset = none, per-client recovery limit off (BL-026)
# SUPPORT_ATTACHMENT_CLEANUP_JOB=off|on   # removes uploads never linked to a message (BL-009)
# SUPPORT_ATTACHMENT_CLEANUP_INTERVAL_MS=3600000
# SUPPORT_UNLINKED_ATTACHMENT_GRACE_HOURS=24

# --- web (apps/web) ---
# API_ORIGIN=http://localhost:3001   # BUILD-time: where the /api rewrite goes (docker/web.Dockerfile build arg; compose passes http://api:3001)
# NEXT_PUBLIC_EMBED_HOST_ORIGINS=    # BUILD-time: origins allowed to embed /embed and post the session (e.g. https://app.orbitmarket.pro); empty = /embed refuses (PH-13.2)
